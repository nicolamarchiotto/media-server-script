#!/bin/sh

# === CONFIGURE THESE ===
BOT_TOKEN="YOUR_BOT_TOKEN_HERE"
CHAT_ID="YOUR_CHAT_ID_HERE"

send_message() {
    TEXT="$1"
    curl -s -X POST "https://api.telegram.org/bot${BOT_TOKEN}/sendMessage" \
         -d chat_id="$CHAT_ID" \
         -d text="$TEXT" >/dev/null
}

# helper: bytes → GB (1 decimal place)
to_gb() {
    awk -v size="$1" 'BEGIN { printf "%.1f", size/1024/1024/1024 }'
}


# === Detect if called by Sonarr or Radarr ===
if [ -n "$sonarr_eventtype" ]; then
    APP="Sonarr"
    EVENT="$sonarr_eventtype"
elif [ -n "$radarr_eventtype" ]; then
    APP="Radarr"
    EVENT="$radarr_eventtype"
else
    send_message "⚠️ Unknown caller for Telegram notifier script."
    exit 1
fi

# === Handle Sonarr events ===
if [ "$APP" = "Sonarr" ]; then
    case "$EVENT" in
      Test)
        send_message "✅ Sonarr Telegram script test successful!"
        ;;
      Grab)
        SIZE_GB=$(to_gb "$sonarr_release_size")
        MESSAGE="📥 [Sonarr] New release grabbed!

📺 Series: $sonarr_series_title
💾 Release: $sonarr_release_title
🌐 Indexer: $sonarr_release_indexer
📦 Size: ${SIZE_GB} GB"
        send_message "$MESSAGE"
        ;;
      Download)
        SIZE_GB=$(to_gb "$sonarr_episodefile_size")
        MESSAGE="✅ [Sonarr] Download completed and imported!

📺 Series: $sonarr_series_title
🎬 Episode: $sonarr_episodefile_episodetitles
💾 File: $sonarr_episodefile_relativepath
🌐 Indexer: $sonarr_release_indexer
📦 Size: ${SIZE_GB} GB"
        send_message "$MESSAGE"
        ;;
    esac
fi

# === Handle Radarr events ===
if [ "$APP" = "Radarr" ]; then
    case "$EVENT" in
      Test)
        send_message "✅ Radarr Telegram script test successful!"
        ;;
      Grab)
        SIZE_GB=$(to_gb "$radarr_release_size")
        MESSAGE="📥 [Radarr] New movie grabbed!

🎬 Title: $radarr_movie_title
📅 Year: $radarr_movie_year
💾 Release: $radarr_release_title
🌐 Indexer: $radarr_release_indexer
📦 Size: ${SIZE_GB} GB"
        send_message "$MESSAGE"
        ;;
      Download)
        SIZE_GB=$(to_gb "$radarr_moviefile_size")
        MESSAGE="✅ [Radarr] Movie download completed and imported!

🎬 Title: $radarr_movie_title
📅 Year: $radarr_movie_year
💾 File: $radarr_moviefile_relativepath
🌐 Indexer: $radarr_release_indexer
📦 Size: ${SIZE_GB} GB"
        send_message "$MESSAGE"
        ;;
    esac
fi

exit 0
